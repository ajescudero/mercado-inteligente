# Optional: default is ./shopping-list.db. Do not commit a catalog or credentials.
# PRICES_DB_PATH=/absolute/path/to/catalog.sqlite3

# Core search and comparison do not require an LLM API.
ENABLE_AI_SUGGESTIONS=false
# OPENAI_API_KEY=

# npm run check sets this for its subprocesses; opt in locally if desired.
NEXT_TELEMETRY_DISABLED=1
