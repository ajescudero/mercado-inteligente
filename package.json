{
  "name": "mercado-inteligente",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "update-data": "python3 data-pipeline/update_prices.py --publish",
    "test:supermarkets": "npx tsx test-supermarkets.ts",
    "test:filters": "node --import tsx -e \"require('./test-filters.ts')\"",
    "test:optimization": "npx tsx test-optimization.ts",
    "test:all": "npm run test:filters && npm run test:recovery",
    "test:recovery": "node --import tsx --test --test-isolation=none tests/*.test.ts && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "check": "node scripts/check.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "data:init": "python3 data-pipeline/init_db.py"
  },
  "dependencies": {
    "@types/lodash": "^4.17.23",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "csv-parser": "^3.2.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "openai": "^6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
